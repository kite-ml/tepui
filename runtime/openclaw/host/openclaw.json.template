{
  "gateway": {
    "mode": "local", "bind": "loopback", "port": 18888,
    "auth": { "mode": "token", "token": "__GATEWAY_TOKEN__" }
  },

  "agents": { "$include": "./generated/agents.json5" },
  "skills": { "$include": "./generated/skills.json5" },
  "models": { "$include": "./generated/models.json5" },
  "channels": { "$include": "./generated/channels.json5" },
  "bindings": { "$include": "./generated/bindings.json5" },

  "tools": {
    "web": {
      // DuckDuckGo ships in the runtime as a KEYLESS search provider
      // (requiresCredential: false, "no API key required"). Named explicitly
      // rather than auto-detected; if a paid key (BRAVE_API_KEY etc) lands in
      // .env later, switch provider here deliberately — auto-detect prefers
      // keyed providers and would silently start spending.
      "search": { "enabled": true, "provider": "duckduckgo" }
    }
  },

  "plugins": {
    "load": { "paths": ["__SLACK_PLUGIN_PATH__"] },
    "entries": {
      "slack": { "enabled": true },
      "duckduckgo": { "enabled": true }
    }
  },

  "cron": {
    "enabled": true,
    "triggers": { "enabled": true }
  }
}
